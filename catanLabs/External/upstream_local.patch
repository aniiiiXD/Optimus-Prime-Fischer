+/// The same CTNN policy prior as AlphaBot, choosing its highest-logit legal
+/// action without any rollout. AlphaBot also excludes trade proposals.
+struct PolicyBot {
+    net: Arc<MlpNet>,
+    obs: Vec<f32>,
+    scratch: NetScratch,
+    allow_trade_offers: bool,
+}
+
+impl PolicyBot {
+    fn new(net: Arc<MlpNet>, allow_trade_offers: bool) -> Self {
+        let scratch = NetScratch::new(&net);
+        Self { net, obs: vec![0.0; OBS_DIM], scratch, allow_trade_offers }
+    }
+}
+
+impl Player for PolicyBot {
+    fn choose_action(&mut self, game: &CatanGame, valid_actions: &[Action]) -> Action {
+        encode_obs(game, game.current_player(), Visibility::Perfect, &mut self.obs);
+        self.net.trunk(&self.obs, &mut self.scratch);
+        let mut best = None;
+        for &action in valid_actions {
+            if !self.allow_trade_offers && matches!(action, Action::ProposeTrade { .. }) { continue; }
+            let score = self.net.logit_from(&self.scratch, encode_action(game, &action));
+            if best.is_none_or(|(previous, _)| score > previous) {
+                best = Some((score, action));
+            }
+        }
+        best.map(|(_, action)| action).unwrap_or(valid_actions[0])
+    }
+}
